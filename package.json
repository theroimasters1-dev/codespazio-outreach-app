{
  "name": "codespazio-outreach-app",
  "version": "1.0.5",
  "description": "CodeSpazio Solutions - AI Client Acquisition & Deal Closer Suite",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --x64",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "keywords": [
    "codespazio",
    "outreach",
    "ai",
    "lead-generation",
    "email-automation",
    "deal-closer"
  ],
  "author": "CodeSpazio Solutions Pvt Ltd",
  "license": "Proprietary",
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.codespazio.outreach",
    "productName": "CodeSpazio Client Acquisition & Deal Closer",
    "copyright": "Copyright © 2026 CodeSpazio Solutions Pvt Ltd",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeSpazio Client Acquisition",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null
    },
    "dmg": {
      "title": "CodeSpazio Client Acquisition Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ]
  }
}
